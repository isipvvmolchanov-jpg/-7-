#Задание 9. Комбинация параметров

def order(item, quantity=1, *extras):
  base_info = f"Товар: {item}, количество: {quantity}"
  if extras:
    extras_list = ", ".join(extras)
    return f"{base_info}. Дополнения: {extras_list}"
  return base_info



print(order("Пицца", 2, "сырный бортик", "острый соус"))
print(order("Кофе"))

#Задание 10. Комбинация параметров

def profile(name, age=18, **details):
  info_list = [f"Имя: {name}", f"Возраст: {age}"]
  for key, value in details.items():
    info_list.append(f"{key} — {value}")
  return info_list



user_profile = profile("Елена", 22, Профессия="Дизайнер", Хобби="Фотография")
print(user_profile)
